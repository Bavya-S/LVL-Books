// LVL Books — Firestore Security Rules
//
// Paste this into: Firebase Console → Build → Firestore Database → Rules tab → Publish.
//
// What this does: only requests carrying a valid Firebase Auth session (which the app
// creates silently and automatically via Anonymous Authentication — nobody has to log in)
// are allowed to read or write. This blocks random internet traffic from touching your
// data, while keeping the app itself login-free for your staff.
//
// Before this works, turn on Anonymous sign-in once:
// Firebase Console → Build → Authentication → Sign-in method → Anonymous → Enable.
//
// Honest limitation: this does NOT distinguish one staff member from another, or stop
// someone who has a copy of the app's files from reading/writing your data (anyone can
// get an anonymous session — that's what "anonymous" means). It stops random bots and
// drive-by traffic, which is what open/test-mode rules don't do. If you later want
// per-staff accounts and permissions, that needs real Firebase Authentication (email/
// password or phone OTP) plus rules that check request.auth.uid against a staff list —
// ask and this can be added as a follow-up.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
